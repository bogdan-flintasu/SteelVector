<!-- Script global: Tema light/dark cu localStorage -->
<script>
(function() {
    const toggle = document.getElementById("tema-toggle-switch");
    const icon = document.getElementById("tema-icon");
    const text = document.getElementById("tema-text");

    function aplicaTema(tema) {
        if (tema === "light") {
            document.body.classList.add("tema-light");
            toggle.checked = true;
            icon.className = "fas fa-sun";
            text.textContent = "Temă deschisă";
        } else {
            document.body.classList.remove("tema-light");
            toggle.checked = false;
            icon.className = "fas fa-moon";
            text.textContent = "Temă întunecată";
        }
    }

    // La incarcare: citim din localStorage
    const temaSalvata = localStorage.getItem("sv-tema");
    aplicaTema(temaSalvata || "dark");

    // La click pe switch
    toggle.addEventListener("change", function() {
        const temaNoua = this.checked ? "light" : "dark";
        localStorage.setItem("sv-tema", temaNoua);
        aplicaTema(temaNoua);
    });
})();
</script>