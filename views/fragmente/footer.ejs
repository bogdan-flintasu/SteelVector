<!-- Bonus 2: Script global pentru teme multiple cu localStorage -->
<script>
(function() {
    const select = document.getElementById("tema-select");
    const temeValide = new Set(["dark", "light", "copper"]);

    function aplicaTema(tema) {
        document.body.classList.remove("tema-light", "tema-copper");
        if (tema === "light") {
            document.body.classList.add("tema-light");
        } else if (tema === "copper") {
            document.body.classList.add("tema-copper");
        }

        if (select && select.value !== tema) {
            select.value = tema;
        }
    }

    const temaSalvata = temeValide.has(localStorage.getItem("sv-tema")) ? localStorage.getItem("sv-tema") : "dark";
    aplicaTema(temaSalvata);

    if (select) {
        select.addEventListener("change", function() {
            const temaNoua = temeValide.has(this.value) ? this.value : "dark";
            localStorage.setItem("sv-tema", temaNoua);
            aplicaTema(temaNoua);
        });
    }
})();
</script>