<!DOCTYPE html>
<html lang="ro">

<head>
  <title>SteelVector</title>
  <meta name="description"
    content="SteelVector vinde structuri metalice solide pentru hale industriale cu profile IPE, HEA si HEB.">
  <meta name="keywords"
    content="metale, structuri metalice, IPE, hala, HEA, HEB, profile, bare, tije, hala, grinzi, otel, constructii, depozit">
  <%- include('../fragmente/head') %>
  <link rel="stylesheet" href="/resurse/css/galerie-animata.css" type="text/css">
</head>

<body class="saira">
  <%- include('../fragmente/header') %>

  <main>
    <section style="padding: 1.5rem 1rem;">
      <h2>Galerie Animata</h2>
      <p>Set curent: <strong><%= n %></strong> imagini</p>
      <div class="galerie-animata-wrapper">
        <div class="galerie-animata-grid">
          <div class="galerie-animata-inner">
            <% imagini.forEach((img) => { %>
              <div class="galerie-animata-item">
                <img src="<%= caleGalerie %>/<%= img.fisier %>" alt="<%= img.alt || img.titlu || "" %>">
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../fragmente/footer') %>
</body>

</html>
